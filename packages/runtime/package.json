{
  "name": "@agentpass/runtime",
  "version": "0.0.1",
  "description": "AgentPass browser runtime — Playwright pool, human behavior simulation, network interception",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "install-browsers": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
