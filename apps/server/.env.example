# AgentPass Server Configuration

# Server
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Postgres database URL — run: createdb agentpass
DATABASE_URL=postgres://localhost:5432/agentpass

# AgentPass secret (must match what the SDK uses)
# Generate a strong secret: openssl rand -hex 32
AGENTPASS_SECRET=change-me-in-production-use-256-bit-random

# Optional: 2captcha API key for CAPTCHA solving
# Without this, CAPTCHA challenges will fail gracefully with an error
# TWOCAPTCHA_API_KEY=your_key_here

# Optional: MCA API key for Ministry of Corporate Affairs
# Without this, MCA searches use the public (unauthenticated) endpoint
# MCA_API_KEY=your_mca_api_key

# Optional: GSTN sandbox credentials
# Without these, GSTN lookup uses the public sandbox endpoint (limited data)
# GSTN_CLIENT_ID=your_client_id
# GSTN_CLIENT_SECRET=your_client_secret
